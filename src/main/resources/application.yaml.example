spring:
  application:
    name: expense-tracker-v1
  datasource:
    url: ${DB_URL:jdbc:postgresql://localhost:5432/expense_tracker}
    username: ${DB_USERNAME:postgres}
    password: ${DB_PASSWORD}
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true
app:
  jwt:
    secret: ${JWT_SECRET}
    expiration: ${JWT_EXPIRATION:PT10H}

logging:
  level:
    org.springframework.security: TRACE
    expense.tracker.v1: DEBUG
    org.hibernate.SQL: DEBUG